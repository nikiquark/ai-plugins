#!/usr/bin/env python3
"""Check that every number in the idea research docs carries a claim label.

Usage: idea-claims [DIR_OR_FILE ...]      (default: docs/idea)

Labels (see the idea-pipeline:research-standards skill):
  [S3] / [S3, S7]  sourced fact; each S-id must be listed in the file's "## Sources" section
  [calc] [est] [hyp] [user]

Errors (exit 1):
  - a line with a quantity (%, money, magnitude, a number of 4+ digits, a decimal) and no label
  - a cited [S#] that is not listed under "## Sources"
Warnings (exit 0):
  - a web source without a URL or without an "accessed YYYY-MM-DD" date
  - a source whose publication year is older than stale_years (.claude/idea-pipeline.json, default 3)

Only research files are checked: brief, issue tree, readiness, experiments and evidence notes hold
the founder's statements, hypotheses and thresholds, so they are skipped.
"""
from __future__ import annotations

import datetime
import json
import re
import sys
from pathlib import Path

CHECKED = ["preflight.md", "market.md", "competitors.md", "customers.md", "strategy.md", "risks.md", "memo.md"]

LABEL = re.compile(r"\[(?:S\d+(?:\s*[,;]\s*S\d+)*|calc|est|hyp|user)\]", re.I)
CITED = re.compile(r"\[(S\d+(?:\s*[,;]\s*S\d+)*)\]", re.I)
SOURCE_DEF = re.compile(r"^\s*[-*]\s*\[(S\d+)\]", re.I)

UNIT = r"(?:%|percent|процент\w*|[kKMB]\b|bn\b|mn\b|mln\b|млн\b|млрд\b|трлн\b|тыс\b|million\b|billion\b|thousand\b|x\b|×)"
CURRENCY = r"(?:[$€£₽¥]|USD|EUR|RUB|GBP|руб\w*|долл\w*|евро)"
QUANTITY = re.compile(
    rf"{CURRENCY}\s?\d"                               # $5, ₽ 300
    rf"|\d(?:[\d.,\s ]*\d)?\s?{UNIT}"            # 40%, 3.5 млрд, 12x
    rf"|\d(?:[\d.,\s ]*\d)?\s?{CURRENCY}"        # 300 ₽, 5 000 руб.
    r"|\b\d{1,3}(?:[  ,]\d{3})+\b"               # 12 000, 1,250,000
    r"|\b\d{4,}\b"                                    # 15000 (years are removed first)
    r"|\b\d+[.,]\d+\b"                                # 2.5, 0,8
)
NOISE = [
    re.compile(r"`[^`]*`"),                           # inline code
    re.compile(r"\]\([^)]*\)"),                       # link targets
    re.compile(r"https?://\S+"),
    re.compile(r"\b\d{4}-\d{2}(?:-\d{2})?\b"),        # ISO dates
    re.compile(r"\b(?:19|20)\d{2}\s?[–-]\s?(?:19|20)?\d{2}\b"),  # year ranges
    re.compile(r"\b(?:19|20)\d{2}\b(?!\s?(?:%|[$€£₽]))"),        # years
    re.compile(r"\b(?:H|EXP-|EV-|CRL|BRL|TRL|TMRL|IPRL|FRL|Q)\s?\d+(?:\.\d+)*\b", re.I),  # ids and levels
    re.compile(r"\b[A-Z]{2,}-\d+\b"),                 # finding ids
    re.compile(r"\bB2[BCG](?:2[BC])?\b"),             # B2B, B2C, B2B2C
    re.compile(r"\b\d\s?[×x]\s?\d\b"),               # 2×2
]
YEAR = re.compile(r"\b(?:19|20)\d{2}\b")
ACCESSED = re.compile(r"accessed\s+\d{4}-\d{2}-\d{2}", re.I)


def stale_years() -> int:
    try:
        return int(json.loads(Path(".claude/idea-pipeline.json").read_text())["stale_years"])
    except (OSError, ValueError, KeyError, TypeError):
        return 3


def check(path: Path, today: int, max_age: int) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    lines = path.read_text(encoding="utf-8").splitlines()
    defined: set[str] = set()
    cited: list[tuple[int, str]] = []
    in_code = False
    section = ""

    for n, raw in enumerate(lines, 1):
        line = raw.rstrip()
        if line.lstrip().startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            continue
        if line.startswith("## "):
            section = line[3:].strip().lower()
            continue
        if line.startswith("#") or re.fullmatch(r"\s*\|?[\s:|-]+\|?\s*", line or "-"):
            continue

        if section == "sources":
            m = SOURCE_DEF.match(line)
            if not m:
                continue
            defined.add(m.group(1).upper())
            user_provided = "user-provided" in line.lower()
            if "http" not in line and not user_provided:
                warnings.append(f"{path}:{n}: source {m.group(1)} has no URL and is not marked user-provided")
            if not ACCESSED.search(line) and not user_provided:
                warnings.append(f"{path}:{n}: source {m.group(1)} has no 'accessed YYYY-MM-DD' date")
            body = ACCESSED.sub("", line)
            years = [int(y) for y in YEAR.findall(body.split("http")[0])]
            if years and today - max(years) > max_age:
                warnings.append(f"{path}:{n}: source {m.group(1)} is from {max(years)}, older than {max_age} years")
            continue
        if section == "data requests":
            continue

        for m in CITED.finditer(line):
            for sid in re.split(r"\s*[,;]\s*", m.group(1)):
                cited.append((n, sid.upper()))

        text = line
        for pattern in NOISE:
            text = pattern.sub(" ", text)
        if QUANTITY.search(text) and not LABEL.search(line):
            errors.append(f"{path}:{n}: number without a claim label: {line.strip()[:120]}")

    for n, sid in cited:
        if sid not in defined:
            errors.append(f"{path}:{n}: [{sid}] is not listed under '## Sources'")
    return errors, warnings


def targets(args: list[str]) -> list[Path]:
    files: list[Path] = []
    for arg in args or ["docs/idea"]:
        p = Path(arg)
        if p.is_dir():
            files.extend(p / name for name in CHECKED if (p / name).is_file())
        elif p.is_file():
            files.append(p)
        else:
            print(f"idea-claims: {p} not found", file=sys.stderr)
    return files


def main() -> int:
    files = targets(sys.argv[1:])
    if not files:
        print("idea-claims: no research files to check", file=sys.stderr)
        return 0
    today, max_age = datetime.date.today().year, stale_years()
    errors: list[str] = []
    warnings: list[str] = []
    for f in files:
        e, w = check(f, today, max_age)
        errors += e
        warnings += w
    for msg in errors:
        print(msg)
    for msg in warnings:
        print(f"warning: {msg}")
    summary = f"idea-claims: {len(files)} file(s), {len(errors)} error(s), {len(warnings)} warning(s)"
    print(summary, file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
